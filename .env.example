# Copy to .env and restart after changes. Never commit credentials.
# Recommended: DeepSeek API for answers + local semantic embeddings.
RAG_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3:4b

# Alternative 1: RAG_PROVIDER=ollama (download OLLAMA_CHAT_MODEL too).
# Alternative 2: RAG_PROVIDER=chatgpt (optional official member sign-in).
# Alternative 3: RAG_PROVIDER=openai for other compatible API services.
# AI_* settings below are NOT used for DeepSeek chat.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EMBED_MODEL=
# Optional online embeddings: set EMBEDDING_PROVIDER=openai and these fields.
# DeepSeek chat credentials are never inherited for embeddings.
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=

# Model alias changed in place? Update this to invalidate old embeddings.
EMBEDDING_REVISION=
MODEL_TIMEOUT=180
EMBED_TIMEOUT=180

# RAG_PROVIDER=local is excerpt-only mode, not full AI RAG.

# Optional: a local directory for SQLite and uploads (relative to this project).
DATA_DIR=data
# Optional: leave blank to generate and persist a local session signing key.
SECRET_KEY=
