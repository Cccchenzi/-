# Copy this file to .env. Leave the key empty for fully local retrieval.
# These settings are read at server startup. Restart after editing.
# The endpoint must support POST /chat/completions with messages.
AI_API_KEY=
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=your-model-name

# Optional: a local directory for SQLite and uploads (relative to this project).
DATA_DIR=data
# Optional: leave blank to generate and persist a local session signing key.
SECRET_KEY=
