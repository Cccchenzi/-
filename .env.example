# Copy to .env and restart after changes. Never commit credentials.
# Recommended here: ChatGPT plan sign-in + local semantic embeddings.
RAG_PROVIDER=chatgpt
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3:4b

# Alternative 1: RAG_PROVIDER=ollama (download OLLAMA_CHAT_MODEL too).
# Alternative 2: RAG_PROVIDER=openai, EMBEDDING_PROVIDER=openai.
# API keys are separate from the ChatGPT authorization flow.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EMBED_MODEL=
# Optional separate embedding endpoint/key; blank inherits AI_BASE_URL/KEY.
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=

# Model alias changed in place? Update this to invalidate old embeddings.
EMBEDDING_REVISION=
MODEL_TIMEOUT=180
EMBED_TIMEOUT=180

# RAG_PROVIDER=local is excerpt-only mode, not full AI RAG.

# Optional: a local directory for SQLite and uploads (relative to this project).
DATA_DIR=data
# Optional: leave blank to generate and persist a local session signing key.
SECRET_KEY=
